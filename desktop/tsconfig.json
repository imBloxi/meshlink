{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node", "w3c-web-serial", "vite/client"],
    "paths": {
      "@core/*": ["./src/core/*"],
      "@ui/*": ["./src/renderer/ui/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src", "*.config.ts"]
}
